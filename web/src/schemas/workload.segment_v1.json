    {
      "name":  "run",
      "description":  "Load shape of the segment.",
      "required":  true,
      "object":  {
        "schema":  {
          "fields":  [
            {
              "name":  "executor",
              "description":  "Scenario executor: constant-vus runs for a duration, shared-iterations shares N iterations between VUs.",
              "choice":  {
                "options":  [
                  {
                    "value":  {
                      "stringValue":  "constant-vus"
                    },
                    "label":  "Constant VUs for a duration"
                  },
                  {
                    "value":  {
                      "stringValue":  "shared-iterations"
                    },
                    "label":  "Shared iterations"
                  }
                ],
                "default":  {
                  "stringValue":  "constant-vus"
                }
              },
              "title":  "Executor"
            },
            {
              "name":  "vus",
              "description":  "Concurrent virtual users (vus); sizes the runner machine and the pool.",
              "int64":  {
                "default":  "1",
                "gte":  "1",
                "lte":  "100000"
              },
              "title":  "Virtual users"
            },
            {
              "name":  "duration",
              "description":  "Wall-clock length of a constant-vus scenario (duration).",
              "nullable":  true,
              "duration":  {
                "gt":  "0s",
                "lte":  "86400s"
              },
              "title":  "Duration"
            },
            {
              "name":  "iterations",
              "description":  "Total iterations of a shared-iterations scenario (iterations).",
              "nullable":  true,
              "int64":  {
                "gte":  "1"
              },
              "title":  "Iterations"
            },
            {
              "name":  "query_timeout",
              "description":  "Per-statement deadline (queryTimeout); 0 disables it.",
              "duration":  {
                "default":  "0s",
                "gte":  "0s",
                "lte":  "3600s"
              },
              "title":  "Query timeout"
            }
          ],
          "rules":  [
            {
              "expr":  "this.executor != \"constant-vus\" || (\"duration\" in this && this.duration != null)",
              "message":  "constant-vus needs a duration",
              "id":  "constant-vus-needs-duration"
            },
            {
              "expr":  "this.executor != \"shared-iterations\" || (\"iterations\" in this && this.iterations != null)",
              "message":  "shared-iterations needs an iteration count",
              "id":  "shared-iterations-needs-count"
            }
          ],
          "strict":  true
        }
      },
      "group":  "Scenario",
      "title":  "Scenario"
    },
    {
      "name":  "steps",
      "description":  "Run only the listed stroppy steps (--steps); empty = all steps.",
      "list":  {
        "items":  [
          {
            "string":  {
              "minLen":  "1",
              "maxLen":  "64",
              "pattern":  "^[a-z][a-z0-9_]*$"
            }
          }
        ],
        "maxItems":  "32",
        "unique":  true
      },
      "group":  "Steps",
      "title":  "Only these steps"
    },
    {
      "name":  "no_steps",
      "description":  "Skip the listed stroppy steps (--no-steps); stroppy rejects it together with steps.",
      "list":  {
        "items":  [
          {
            "string":  {
              "minLen":  "1",
              "maxLen":  "64",
              "pattern":  "^[a-z][a-z0-9_]*$"
            }
          }
        ],
        "maxItems":  "32",
        "unique":  true
      },
      "group":  "Steps",
      "title":  "Skip these steps"
    },
    {
      "name":  "extra_params",
      "description":  "Typed stroppy flags this form does not model, by flag name without dashes (load-workers); values are parsed by stroppy.",
      "rules":  [
        {
          "expr":  "this.all(k, k.matches(\"^[a-z][a-z0-9-]*$\"))",
          "message":  "extra parameter keys must be stroppy flag names (lower-kebab)",
          "id":  "extra-param-key-shape"
        }
      ],
      "map":  {
        "maxEntries":  "64",
        "valueField":  {
          "name":  "value",
          "string":  {
            "maxLen":  "4096"
          }
        }
      },
      "group":  "Workload",
      "title":  "Extra parameters"
    },
    {
      "name":  "files",
      "description":  "Extra files (SQL dialects, schemas, data) shipped with the segment.",
      "list":  {
        "items":  [
          {
            "object":  {
              "schema":  {
                "fields":  [
                  {
                    "name":  "name",
                    "description":  "Name the file gets in the segment workspace; reference it from sql_file/schema_file.",
                    "required":  true,
                    "string":  {
                      "minLen":  "1",
                      "maxLen":  "128",
                      "pattern":  "^[A-Za-z0-9._/-]+$"
                    },
                    "title":  "File name"
                  },
                  {
                    "name":  "kind",
                    "description":  "What the file is: a schema/DDL file, a config, or a data file.",
                    "choice":  {
                      "options":  [
                        {
                          "value":  {
                            "stringValue":  "sql"
                          },
                          "label":  "SQL / DDL"
                        },
                        {
                          "value":  {
                            "stringValue":  "conf"
                          },
                          "label":  "Config"
                        },
                        {
                          "value":  {
                            "stringValue":  "data"
                          },
                          "label":  "Data"
                        }
                      ],
                      "default":  {
                        "stringValue":  "sql"
                      }
                    },
                    "title":  "Kind"
                  },
                  {
                    "name":  "content",
                    "description":  "Inline file body, at most 1 MiB.",
                    "string":  {
                      "maxLen":  "1048576"
                    },
                    "title":  "Content"
                  },
                  {
                    "name":  "ref",
                    "description":  "Artifact/object reference to fetch instead of inline content.",
                    "string":  {
                      "minLen":  "1",
                      "maxLen":  "512"
                    },
                    "title":  "Reference"
                  }
                ],
                "rules":  [
                  {
                    "expr":  "(\"content\" in this) != (\"ref\" in this)",
                    "message":  "a file needs exactly one of content or ref",
                    "id":  "file-content-xor-ref"
                  }
                ],
                "strict":  true
              }
            }
          }
        ],
        "maxItems":  "32"
      },
      "group":  "Files",
      "title":  "Files"
    },
    {
      "name":  "thresholds",
      "description":  "Pass/fail bounds the pipeline applies to the segment summary.",
      "object":  {
        "schema":  {
          "fields":  [
            {
              "name":  "p99_ms",
              "description":  "Fail the segment when iteration_duration p99 exceeds this.",
              "double":  {
                "gt":  0
              },
              "unit":  "ms",
              "title":  "p99 latency"
            },
            {
              "name":  "error_rate",
              "description":  "Fail the segment when failed_iterations / iterations exceeds this (0..1).",
              "double":  {
                "gte":  0,
                "lte":  1
              },
              "unit":  "ratio",
              "title":  "Error rate"
            }
          ],
          "strict":  true
        }
      },
      "group":  "Thresholds",
      "title":  "Thresholds"
    },
    {
      "name":  "warmup",
      "description":  "Idle wait before the segment starts, letting caches and replicas settle.",
      "duration":  {
        "default":  "0s",
        "gte":  "0s",
        "lte":  "3600s"
      },
      "group":  "Scenario",
      "title":  "Warm-up"
    },
    {
      "name":  "log_level",
      "description":  "Minimum stroppy log level (--log-level); debug traces parameter resolution.",
      "choice":  {
        "options":  [
          {
            "value":  {
              "stringValue":  "debug"
            },
            "label":  "debug"
          },
          {
            "value":  {
              "stringValue":  "info"
            },
            "label":  "info"
          },
          {
            "value":  {
              "stringValue":  "warn"
            },
            "label":  "warn"
          },
          {
            "value":  {
              "stringValue":  "error"
            },
            "label":  "error"
          }
        ],
        "default":  {
          "stringValue":  "info"
        }
      },
      "group":  "Segment",
      "title":  "Log level"
    }
  ],
  "rules":  [
    {
      "expr":  "!(\"steps\" in root) || !(\"no_steps\" in root) || size(root.steps) == 0 || size(root.no_steps) == 0",
      "message":  "stroppy rejects --steps together with --no-steps",
      "id":  "steps-mutually-exclusive"
    },
    {
      "expr":  "!(\"workload\" in root) || root.workload.script != \"execute_sql\" || ((\"sql_body\" in root.workload && root.workload.sql_body != null) != (\"sql_file\" in root.workload && root.workload.sql_file != null))",
      "message":  "execute_sql needs exactly one of sql_body or sql_file",
      "id":  "execute-sql-source"
    }
  ],
  "strict":  true,
  "coerce":  true
}
