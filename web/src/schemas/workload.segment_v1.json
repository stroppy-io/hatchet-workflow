{
  "id":  {
    "namespace":  "workload",
    "name":  "segment",
    "version":  "v1.0.0"
  },
  "description":  "One stroppy load segment: workload, typed parameters, scenario, steps and files.",
  "fields":  [
    {
      "name":  "name",
      "description":  "Segment id inside the workload; used as the phase label of the run and as a metric label.",
      "required":  true,
      "string":  {
        "minLen":  "1",
        "maxLen":  "64",
        "pattern":  "^[a-z][a-z0-9_-]*$"
      },
      "group":  "Segment",
      "title":  "Name"
    },
