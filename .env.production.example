# Production environment — copy to .env.production and fill in real values.
# Start: docker compose --profile prod --env-file .env.production up -d
# Same variable names as the local .env — only the values differ.

# Bind published ports to localhost only (Caddy terminates external traffic).
BIND_ADDR=127.0.0.1

# PostgreSQL
POSTGRES_PASSWORD=<change-me>

# Valkey
VALKEY_PASSWORD=<change-me>

# JWT signing secret (32+ chars)
JWT_SECRET=<change-me>

# VictoriaMetrics/VictoriaLogs auth token (vmauth bearer)
MONITORING_TOKEN=<change-me>

# MinIO (S3 package store)
MINIO_ROOT_USER=stroppy
MINIO_ROOT_PASSWORD=<change-me>
STROPPY_S3_BUCKET=stroppy-packages

# Root admin (seeded at first server start)
STROPPY_ROOT_ADMIN_EMAIL=admin@cloud.stroppy.io
STROPPY_ROOT_ADMIN_PASSWORD=<change-me>

# Public control-plane address handed to provisioned agents.
STROPPY_SERVER_ADDR=https://cloud.stroppy.io
STROPPY_SHARE_BASE_URL=https://cloud.stroppy.io/share/

# Grafana (proxied through Caddy under /grafana)
GF_ADMIN_PASSWORD=<change-me>
GF_ANON_ENABLED=false
GRAFANA_URL=https://cloud.stroppy.io/grafana
GF_ROOT_URL=https://cloud.stroppy.io/grafana/
GF_SERVE_SUB_PATH=true

# GitHub token for stroppy-release version lookups
GITHUB_TOKEN=

# Yandex Cloud (optional — only for YANDEX-provider runs)
YC_TOKEN=
YC_CLOUD_ID=
YC_FOLDER_ID=
