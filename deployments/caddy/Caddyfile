(stroppy_forward_proxy) {
	@forward_proxy expression `{http.request.orig_uri}.startsWith("http://") || {http.request.orig_uri}.startsWith("https://")`

	handle @forward_proxy {
		reverse_proxy {$CADDY_UPSTREAM:127.0.0.1:8080} {
			header_up X-Stroppy-Forward-Proxy 1
			header_up Host {http.request.host}
			# Cluster deploys fire many concurrent apt requests; the gateway's
			# cmux listener occasionally refuses a fresh connection, which Caddy
			# otherwise turns into an immediate 503 that fails the apt fetch.
			# Retry the upstream for a few seconds so transient dial hiccups are
			# absorbed instead of surfacing as 503 to apt.
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}
}

(stroppy_gateway) {
	import stroppy_forward_proxy

	@grpc protocol grpc

	handle @grpc {
		reverse_proxy h2c://{$CADDY_UPSTREAM:127.0.0.1:8080}
	}

	handle /grafana/* {
		reverse_proxy {$CADDY_GRAFANA_UPSTREAM:127.0.0.1:3001}
	}

	handle {
		reverse_proxy {$CADDY_UPSTREAM:127.0.0.1:8080}
	}
}

{$CADDY_SITE_ADDRESS:http://localhost, http://caddy} {
	import stroppy_gateway
}

https:// {
	import stroppy_forward_proxy
}
